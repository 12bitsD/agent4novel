# Canonical HOW: docs/wiki/016-model-runtime-provider-config.md
# 启动默认模型。空值表示自动选择：DeepSeek key 优先；只有 LongCat key 时选择 LongCat；都无 key 时 demo。
# 显式选择模型却缺对应 key 会启动失败。示例：longcat:LongCat-2.0 / deepseek:deepseek-chat
A4N_MODEL=
# server 单次 LLM 调用超时：代码缺省 120000ms，合法范围 1000..900000ms；LongCat 建议 300000ms。
# CLI 请求另用 --timeout-ms / A4N_CLI_TIMEOUT_MS 全局覆盖（普通请求默认 300000ms，advance 默认 1820000ms；CLI 不自动读取本文件）。
A4N_LLM_TIMEOUT_MS=300000

# 复制为 .env.local 后 chmod 600；不要提交、打印或把真实 key 写进命令。shell/CI 变量优先。
LONGCAT_API_KEY=
# provider base URL：server -> LongCat，不是 CLI -> agent4novel 的 A4N_BASE_URL。
LONGCAT_BASE_URL=https://api.longcat.chat/openai/v1

# 可选：DeepSeek adapter。模型 ID 使用 deepseek:<model>。
DEEPSEEK_API_KEY=
# provider base URL：server -> DeepSeek。
DEEPSEEK_BASE_URL=https://api.deepseek.com
