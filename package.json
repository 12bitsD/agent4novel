{
  "name": "agent4novel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "cli": ".venv/bin/a4n",
    "test:backend": ".venv/bin/python -m pytest apps/backend",
    "test": "pnpm test:backend && pnpm -r --workspace-concurrency=1 --if-present run test --maxWorkers=2",
    "typecheck:backend": ".venv/bin/python -m mypy apps/backend/src && .venv/bin/python -m ruff check apps/backend && .venv/bin/python -m ruff format --check apps/backend",
    "typecheck": "pnpm typecheck:backend && pnpm -r --if-present run typecheck",
    "build:backend": ".venv/bin/python -m pip wheel --no-deps --no-build-isolation --wheel-dir .data/build apps/backend",
    "build": "pnpm build:backend && pnpm --filter @agent4novel/web build",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "typescript-eslint": "8.72.0"
  }
}
